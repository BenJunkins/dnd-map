{
  "name": "region-bestiary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dev tooling for the Region Bestiary Foundry VTT module. The module itself ships no runtime dependencies.",
  "scripts": {
    "normalize-regions": "node tools/normalize-regions.js",
    "score": "node tools/score-preview.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 \"test/**/*.test.js\"",
    "check": "npm run lint && npm run coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "handlebars": "^4.7.10"
  },
  "engines": {
    "node": ">=24"
  }
}
